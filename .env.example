PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# SMTP server secrets - never put these in Vite/frontend code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-email@example.com
SMTP_TEST_TO=your-email@example.com

# Telegram bot secrets - create with @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=replace-me

# SieuThiCode bank API - keep token on backend only
BANK_API_TOKEN=replace-with-sieuthicode-api-token
BANK_API_LIMIT=50
BANK_WEBHOOK_SECRET=replace-with-a-long-random-secret
